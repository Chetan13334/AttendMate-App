# Development API URL - Uses proxy to avoid CORS issues
VITE_API_URL=/api

# If you need to use the direct URL (without proxy), uncomment the line below and comment the above line
# VITE_API_URL=http://localhost:5000/api

# Production API URL (update this with your actual production URL when deploying)
# VITE_API_URL=https://your-production-api.com/api